# -----------------------------
# 1. Health-Check (GET)
# -----------------------------
GET http://127.0.0.1:8000/api/v1/control/health
Accept: application/json

###

# -----------------------------
# 2. Befehl: Vorwärts (POST)
# -----------------------------
POST http://127.0.0.1:8000/api/v1/control/command
Content-Type: application/json

{
  "command": "forward"
}

###

# -----------------------------
# 3. Befehl: Rückwärts (POST)
# -----------------------------
POST http://127.0.0.1:8000/api/v1/control/command
Content-Type: application/json

{
  "command": "backward"
}

###

# -----------------------------
# 4. Befehl: Links drehen (POST)
