POST http://127.0.0.1:8000/api/v1/control/command
Content-Type: application/json

{
  "command": "left"
}

###

# -----------------------------
# 5. Befehl: Rechts drehen (POST)
# -----------------------------
POST http://127.0.0.1:8000/api/v1/control/command
Content-Type: application/json

{
  "command": "right"
}

